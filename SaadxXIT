-- ============================================
-- AIMBOT (COM REVALIDAÇÃO CONTÍNUA DO ALVO)
-- ============================================
function iniciarAimbot()
    local G = game
    local RS = G:GetService("RunService")
    local C = workspace.CurrentCamera
    local LP = G.Players.LocalPlayer
    
    local SMOOTH = 0.3
    
    local function isTargetValid(target)
        if not target or target == LP then return false end
        local char = target.Character
        if not char then return false end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local head = char:FindFirstChild("Head")
        if not head then return false end
        
        local pos, onScreen = C:WorldToViewportPoint(head.Position)
        if not onScreen then return false end
        
        local center = C.ViewportSize / 2
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist > settings.fov then return false end
        
        if settings.wallCheck then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = {LP.Character}
            params.IgnoreWater = true
            
            local camPos = C.CFrame.Position
            local direction = head.Position - camPos
            local result = workspace:Raycast(camPos, direction, params)
            
            if not result or not result.Instance:IsDescendantOf(char) then
                return false
            end
        end
        
        return true
    end
    
    local function getClosestTarget()
        local bestTarget = nil
        local bestDist = math.huge
        local center = C.ViewportSize / 2
        
        for _, player in pairs(G.Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local char = player.Character
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local head = char:FindFirstChild("Head")
                    if head then
                        local pos, onScreen = C:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if dist < settings.fov and dist < bestDist then
                                if settings.wallCheck then
                                    local params = RaycastParams.new()
                                    params.FilterType = Enum.RaycastFilterType.Blacklist
                                    params.FilterDescendantsInstances = {LP.Character}
                                    local result = workspace:Raycast(
                                        C.CFrame.Position,
                                        (head.Position - C.CFrame.Position).Unit * 1000,
                                        params
                                    )
                                    if result and result.Instance:IsDescendantOf(char) then
                                        bestTarget = player
                                        bestDist = dist
                                    end
                                else
                                    bestTarget = player
                                    bestDist = dist
                                end
                            end
                        end
                    end
                end
            end
        end
        return bestTarget
    end
    
    local currentTarget = nil
    
    addConnection(RS.RenderStepped:Connect(function(deltaTime)
        if not settings.aimbot then
            currentTarget = nil
            return
        end
        
        if currentTarget then
            if not isTargetValid(currentTarget) then
                currentTarget = nil
            end
        end
        
        local novoTarget = getClosestTarget()
        
        if not currentTarget then
            currentTarget = novoTarget
        elseif novoTarget and novoTarget ~= currentTarget then
            local headAtual = currentTarget.Character and currentTarget.Character:FindFirstChild("Head")
            local headNovo = novoTarget.Character and novoTarget.Character:FindFirstChild("Head")
            
            if headAtual and headNovo then
                local center = C.ViewportSize / 2
                local posAtual = C:WorldToViewportPoint(headAtual.Position)
                local posNovo = C:WorldToViewportPoint(headNovo.Position)
                
                if posAtual and posNovo then
                    local distAtual = (Vector2.new(posAtual.X, posAtual.Y) - center).Magnitude
                    local distNovo = (Vector2.new(posNovo.X, posNovo.Y) - center).Magnitude
                    
                    if distNovo < distAtual - 5 then
                        currentTarget = novoTarget
                    end
                end
            end
        end
        
        if not currentTarget then return end
        
        local head = currentTarget.Character:FindFirstChild("Head")
        if not head then
            currentTarget = nil
            return
        end
        
        local targetPos = head.Position
        local camPos = C.CFrame.Position
        local dir = (targetPos - camPos).unit
        
        if dir.Magnitude < 0.001 then return end
        
        local targetCF = CFrame.lookAt(camPos, camPos + dir)
        
        local smoothFactor = SMOOTH * deltaTime * 60
        smoothFactor = math.clamp(smoothFactor, 0.01, 1.0)
        
        C.CFrame = C.CFrame:Lerp(targetCF, smoothFactor)
    end))
end

