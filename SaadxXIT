function iniciarESP()
    local G = game
    local RS = G:GetService("RunService")
    local C = workspace.CurrentCamera
    local LP = G.Players.LocalPlayer
    
    -- Armazena dados do ESP por jogador
    local espData = {}
    
    -- Função para criar os objetos de um jogador
    local function createESPObjects(player)
        if espData[player] then return end
        
        local data = {
            box = nil,
            line = nil,
            name = nil,
            distance = nil,
            active = true,
            character = nil
        }
        
        -- Box
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = Color3.fromRGB(255, 255, 255)
        box.Thickness = 1.5
        box.Filled = false
        data.box = box
        
        -- Line
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Thickness = 1
        data.line = line
        
        -- Name
        local name = Drawing.new("Text")
        name.Visible = false
        name.Color = Color3.fromRGB(255, 255, 255)
        name.Size = 12
        name.Center = true
        name.Outline = true
        name.OutlineColor = Color3.fromRGB(0, 0, 0)
        name.Font = 2
        data.name = name
        
        -- Distance
        local distance = Drawing.new("Text")
        distance.Visible = false
        distance.Color = Color3.fromRGB(255, 255, 255)
        distance.Size = 11
        distance.Center = true
        distance.Outline = true
        distance.OutlineColor = Color3.fromRGB(0, 0, 0)
        distance.Font = 2
        data.distance = distance
        
        espData[player] = data
    end
    
    -- Função para remover todos os objetos de um jogador
    local function removeESPObjects(player)
        local data = espData[player]
        if data then
            if data.box then data.box:Remove() end
            if data.line then data.line:Remove() end
            if data.name then data.name:Remove() end
            if data.distance then data.distance:Remove() end
            espData[player] = nil
        end
    end
    
    -- Função para esconder todos os ESPs de um jogador
    local function hideESP(player)
        local data = espData[player]
        if data then
            if data.box then data.box.Visible = false end
            if data.line then data.line.Visible = false end
            if data.name then data.name.Visible = false end
            if data.distance then data.distance.Visible = false end
        end
    end
    
    -- Verifica se um jogador está vivo e visível
    local function isPlayerValid(player)
        if not player or player == LP then return false end
        local char = player.Character
        if not char then return false end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        return true
    end
    
    -- Obtém as partes do personagem
    local function getCharacterParts(char)
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        return head, root
    end
    
    -- Atualiza o ESP de um jogador
    local function updateESP(player)
        local data = espData[player]
        if not data then return end
        
        -- Verifica se o jogador é válido
        if not isPlayerValid(player) then
            hideESP(player)
            return
        end
        
        local char = player.Character
        local head, root = getCharacterParts(char)
        
        if not head or not root then
            hideESP(player)
            return
        end
        
        local headPos, headOnScreen = C:WorldToViewportPoint(head.Position)
        local rootPos, rootOnScreen = C:WorldToViewportPoint(root.Position)
        
        if not headOnScreen or not rootOnScreen then
            hideESP(player)
            return
        end
        
        -- Verifica se está dentro da tela
        local viewport = C.ViewportSize
        if headPos.X < -10 or headPos.X > viewport.X + 10 or 
           headPos.Y < -10 or headPos.Y > viewport.Y + 10 then
            hideESP(player)
            return
        end
        
        local headPos2D = Vector2.new(headPos.X, headPos.Y)
        local rootPos2D = Vector2.new(rootPos.X, rootPos.Y)
        
        -- ===== BOX =====
        if settings.espBox then
            local height = math.abs(headPos.Y - rootPos.Y) * 2.8
            local width = height * 0.5
            
            local centerX = (headPos.X + rootPos.X) / 2
            local centerY = (headPos.Y + rootPos.Y) / 2
            
            data.box.Size = Vector2.new(width, height)
            data.box.Position = Vector2.new(centerX - width/2, centerY - height/2)
            data.box.Visible = true
        else
            data.box.Visible = false
        end
        
        -- ===== LINE =====
        if settings.espLine then
            local bottomCenter = Vector2.new(viewport.X / 2, viewport.Y)
            data.line.From = bottomCenter
            data.line.To = headPos2D
            data.line.Visible = true
        else
            data.line.Visible = false
        end
        
        -- ===== NAME =====
        if settings.espName then
            data.name.Text = player.Name
            data.name.Position = Vector2.new(headPos.X, headPos.Y - 20)
            data.name.Visible = true
        else
            data.name.Visible = false
        end
        
        -- ===== DISTANCE =====
        if settings.espDistance then
            local localRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if localRoot then
                local dist = (root.Position - localRoot.Position).Magnitude
                data.distance.Text = string.format("[%dm]", math.floor(dist + 0.5))
                data.distance.Position = Vector2.new(headPos.X, headPos.Y + 15)
                data.distance.Visible = true
            else
                data.distance.Visible = false
            end
        else
            data.distance.Visible = false
        end
    end
    
    -- Função para configurar ESP para um jogador
    local function setupESPForPlayer(player)
        if player == LP then return end
        
        if not espData[player] then
            createESPObjects(player)
        end
        
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
        end)
    end
    
    -- Configura ESP para todos os jogadores existentes
    for _, player in pairs(G.Players:GetPlayers()) do
        setupESPForPlayer(player)
    end
    
    -- Conecta eventos para novos jogadores
    G.Players.PlayerAdded:Connect(function(player)
        setupESPForPlayer(player)
    end)
    
    -- Limpa ESP quando um jogador sai
    G.Players.PlayerRemoving:Connect(function(player)
        removeESPObjects(player)
    end)
    
    -- Loop principal de atualização
    RS.RenderStepped:Connect(function()
        if not keyValidada then return end
        
        for _, player in pairs(G.Players:GetPlayers()) do
            if player ~= LP then
                if not espData[player] then
                    createESPObjects(player)
                end
                updateESP(player)
            end
        end
    end)
end

