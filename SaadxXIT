-- ============================================
-- ESP
-- ============================================
function iniciarESP()
    local G = game
    local RS = G:GetService("RunService")
    local C = workspace.CurrentCamera
    local LP = G.Players.LocalPlayer
    
    local function createESPObjects(player)
        if EspData[player] then return end
        
        local data = {}
        
        data.box = addDrawing(Drawing.new("Square"))
        data.box.Visible = false
        data.box.Color = Color3.fromRGB(255, 255, 255)
        data.box.Thickness = 1.5
        data.box.Filled = false
        
        data.name = addDrawing(Drawing.new("Text"))
        data.name.Visible = false
        data.name.Color = Color3.fromRGB(255, 255, 255)
        data.name.Size = 12
        data.name.Center = true
        data.name.Outline = true
        data.name.OutlineColor = Color3.fromRGB(0, 0, 0)
        data.name.Font = 2
        
        data.distance = addDrawing(Drawing.new("Text"))
        data.distance.Visible = false
        data.distance.Color = Color3.fromRGB(255, 255, 255)
        data.distance.Size = 11
        data.distance.Center = true
        data.distance.Outline = true
        data.distance.OutlineColor = Color3.fromRGB(0, 0, 0)
        data.distance.Font = 2
        
        data.tracer = addDrawing(Drawing.new("Line"))
        data.tracer.Visible = false
        data.tracer.Color = Color3.fromRGB(255, 255, 255)
        data.tracer.Thickness = 1
        
        data.healthBarBg = addDrawing(Drawing.new("Square"))
        data.healthBarBg.Visible = false
        data.healthBarBg.Color = Color3.fromRGB(80, 0, 0)
        data.healthBarBg.Filled = true
        data.healthBarBg.Thickness = 1
        
        data.healthBarFill = addDrawing(Drawing.new("Square"))
        data.healthBarFill.Visible = false
        data.healthBarFill.Color = Color3.fromRGB(0, 255, 0)
        data.healthBarFill.Filled = true
        data.healthBarFill.Thickness = 1
        
        EspData[player] = data
    end
    
    local function removeESPObjects(player)
        local data = EspData[player]
        if data then
            for _, obj in pairs(data) do
                if obj then
                    pcall(function() obj:Remove() end)
                end
            end
            EspData[player] = nil
        end
    end
    
    local function hideESP(player)
        local data = EspData[player]
        if data then
            for _, obj in pairs(data) do
                if obj then
                    obj.Visible = false
                end
            end
        end
    end
    
    local function isPlayerValid(player)
        if not player or player == LP then return false end
        local char = player.Character
        if not char then return false end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        return true
    end
    
    local function updateESP(player)
        local data = EspData[player]
        if not data then return end
        
        if not isPlayerValid(player) then
            hideESP(player)
            return
        end
        
        local char = player.Character
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        
        if not head or not root or not humanoid then
            hideESP(player)
            return
        end
        
        local localRootCheck = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if localRootCheck then
            local distCheck = (root.Position - localRootCheck.Position).Magnitude
            if distCheck > settings.espDistanceMax then
                hideESP(player)
                return
            end
        end
        
        local headPos, headOnScreen = C:WorldToViewportPoint(head.Position)
        local rootPos, rootOnScreen = C:WorldToViewportPoint(root.Position)
        
        if not headOnScreen or not rootOnScreen then
            hideESP(player)
            return
        end
        
        local viewport = C.ViewportSize
        if headPos.X < -10 or headPos.X > viewport.X + 10 or 
           headPos.Y < -10 or headPos.Y > viewport.Y + 10 then
            hideESP(player)
            return
        end
        
        local headPos2D = Vector2.new(headPos.X, headPos.Y)
        
        local boxHeight = math.abs(headPos.Y - rootPos.Y) * 2.8
        local boxWidth = boxHeight * 0.5
        local centerX = (headPos.X + rootPos.X) / 2
        local centerY = (headPos.Y + rootPos.Y) / 2
        local boxX = centerX - boxWidth / 2
        local boxY = centerY - boxHeight / 2
        
        if settings.espBox then
            data.box.Size = Vector2.new(boxWidth, boxHeight)
            data.box.Position = Vector2.new(boxX, boxY)
            data.box.Visible = true
        else
            data.box.Visible = false
        end
        
        if settings.espName then
            data.name.Text = player.Name
            data.name.Position = Vector2.new(headPos.X, headPos.Y - 20)
            data.name.Visible = true
        else
            data.name.Visible = false
        end
        
        if settings.espDistance then
            local localRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if localRoot then
                local dist = (root.Position - localRoot.Position).Magnitude
                data.distance.Text = string.format("[%dm]", math.floor(dist + 0.5))
                data.distance.Position = Vector2.new(headPos.X, headPos.Y + 15)
                data.distance.Visible = true
            else
                data.distance.Visible = false
            end
        else
            data.distance.Visible = false
        end
        
        if settings.espTracer then
            local topCenter = Vector2.new(C.ViewportSize.X / 2, 0)
            data.tracer.From = topCenter
            data.tracer.To = headPos2D
            data.tracer.Visible = true
        else
            data.tracer.Visible = false
        end
        
        if settings.espHealthBar then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            healthPercent = math.clamp(healthPercent, 0, 1)
            
            local barWidth = 3
            local barHeight = boxHeight
            local barX = boxX - barWidth - 3
            local barY = boxY
            
            data.healthBarBg.Size = Vector2.new(barWidth, barHeight)
            data.healthBarBg.Position = Vector2.new(barX, barY)
            data.healthBarBg.Visible = true
            
            local fillHeight = barHeight * healthPercent
            data.healthBarFill.Size = Vector2.new(barWidth, fillHeight)
            data.healthBarFill.Position = Vector2.new(barX, barY + (barHeight - fillHeight))
            
            local corFinal
            if healthPercent >= 0.5 then
                local t = (1 - healthPercent) / 0.5
                corFinal = Color3.fromRGB(math.floor(255 * t), 255, 0)
            else
                local t = (0.5 - healthPercent) / 0.5
                corFinal = Color3.fromRGB(255, math.floor(255 * (1 - t)), 0)
            end
            
            data.healthBarFill.Color = corFinal
            data.healthBarFill.Visible = true
        else
            data.healthBarBg.Visible = false
            data.healthBarFill.Visible = false
        end
    end
    
    local function setupESPForPlayer(player)
        if player == LP then return end
        if not EspData[player] then
            createESPObjects(player)
        end
    end
    
    for _, player in pairs(G.Players:GetPlayers()) do
        setupESPForPlayer(player)
    end
    
    addConnection(G.Players.PlayerAdded:Connect(function(player)
        setupESPForPlayer(player)
    end))
    
    addConnection(G.Players.PlayerRemoving:Connect(function(player)
        removeESPObjects(player)
    end))
    
    addConnection(RS.RenderStepped:Connect(function()
        if not keyValidada then return end
        
        for _, player in pairs(G.Players:GetPlayers()) do
            if player ~= LP then
                if not EspData[player] then
                    createESPObjects(player)
                end
                updateESP(player)
            end
        end
    end))
end

