-- SISTEMA AUTO FARM LIXEIRO
-- ============================================
local AutoFarmRunning = false
local AutoFarmTarget = nil
local AutoFarmLastSearch = 0
local AutoFarmSearchCooldown = 1
local AutoFarmColetaEmAndamento = false

local AutoFarmDebug = false

local function debugPrint(msg)
    if AutoFarmDebug then
        print("[AUTO FARM] " .. msg)
    end
end

local function acharLixoMaisProximo()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local lixoMaisProximo = nil
    local distanciaMinima = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj
            and obj.Parent
            and obj.Name == "Lixo"
            and obj:IsA("BasePart")
            and obj.Material == Enum.Material.SmoothPlastic
        then
            local dist = (obj.Position - root.Position).Magnitude
            if dist < distanciaMinima then
                distanciaMinima = dist
                lixoMaisProximo = obj
            end
        end
    end
    
    return lixoMaisProximo
end

local function lixoAindaValido(lixo)
    if not lixo then return false end
    if not lixo.Parent then return false end
    if lixo.Name ~= "Lixo" then return false end
    if not lixo:IsA("BasePart") then return false end
    if lixo.Material ~= Enum.Material.SmoothPlastic then return false end
    return true
end

local function acharPromptDoLixo(lixo)
    if not lixo or not lixo.Parent then return nil end
    local prompt = lixo:FindFirstChild("prompt")
    if not prompt then
        prompt = lixo:FindFirstChildOfClass("ProximityPrompt")
    end
    if not prompt then
        prompt = lixo:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return prompt
end

local function pararAutoFarm()
    AutoFarmRunning = false
    AutoFarmTarget = nil
    AutoFarmColetaEmAndamento = false
    debugPrint("Auto Farm desligado")
end

local function iniciarAutoFarm()
    AutoFarmRunning = false
    task.wait(0.1)
    
    AutoFarmRunning = true
    AutoFarmTarget = nil
    AutoFarmColetaEmAndamento = false
    AutoFarmLastSearch = 0
    
    debugPrint("Auto Farm ligado")
    
    task.spawn(function()
        while AutoFarmRunning do
            if not settings.autoFarmLixeiro then
                AutoFarmRunning = false
                AutoFarmTarget = nil
                debugPrint("Auto Farm desligado (toggle)")
                break
            end
            
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if not (hum and root and hum.Health > 0) then
                task.wait(0.5)
                continue
            end
            
            if AutoFarmColetaEmAndamento then
                task.wait(0.2)
                continue
            end
            
            if AutoFarmTarget and not lixoAindaValido(AutoFarmTarget) then
                debugPrint("Alvo inválido, descartando")
                AutoFarmTarget = nil
            end
            
            if not AutoFarmTarget then
                local agora = tick()
                if agora - AutoFarmLastSearch >= AutoFarmSearchCooldown then
                    AutoFarmLastSearch = agora
                    AutoFarmTarget = acharLixoMaisProximo()
                    
                    if AutoFarmTarget then
                        debugPrint("Novo lixo encontrado: " .. AutoFarmTarget:GetFullName())
                    else
                        debugPrint("Procurando próximo lixo...")
                    end
                end
                
                if not AutoFarmTarget then
                    task.wait(1)
                    continue
                end
            end
            
            local prompt = acharPromptDoLixo(AutoFarmTarget)
            if not prompt then
                debugPrint("Lixo sem prompt, descartando")
                AutoFarmTarget = nil
                task.wait(0.3)
                continue
            end
            
            local dist = (AutoFarmTarget.Position - root.Position).Magnitude
            
            if dist > 5 then
                hum:MoveTo(AutoFarmTarget.Position)
                task.wait(0.2)
            else
                hum:MoveTo(root.Position)
                
                AutoFarmColetaEmAndamento = true
                local alvoColeta = AutoFarmTarget
                
                task.wait(0.15)
                
                local promptAtual = acharPromptDoLixo(alvoColeta)
                if promptAtual and promptAtual.Enabled then
                    pcall(function()
                        promptAtual:InputHoldBegin()
                        task.wait(promptAtual.HoldDuration + 0.1)
                        promptAtual:InputHoldEnd()
                    end)
                    
                    debugPrint("Lixo coletado")
                end
                
                task.wait(0.4)
                
                AutoFarmTarget = nil
                AutoFarmColetaEmAndamento = false
                AutoFarmLastSearch = 0
                
                debugPrint("Procurando próximo lixo...")
                
                task.wait(0.3)
            end
        end
    end)
end

