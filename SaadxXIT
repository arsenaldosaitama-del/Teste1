local function atualizarStatusSpectate()
    if not SpectateStatusLabel then return end
    if SpectateTarget then
        SpectateStatusLabel.Text = "Status: Espectando " .. SpectateTarget.Name
        SpectateStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        SpectateStatusLabel.Text = "Status: Não espectando"
        SpectateStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 200)
    end
end

local function pararSpectate()
    if SpectateConnection then
        pcall(function() SpectateConnection:Disconnect() end)
        SpectateConnection = nil
    end
    SpectateTarget = nil
    Camera.CameraType = Enum.CameraType.Custom
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraSubject = hum
        end
    end
    atualizarStatusSpectate()
end

local function spectatePlayer(player)
    if not player or player == LocalPlayer then return end
    if not player.Character then return end
    
    pararSpectate()
    SpectateTarget = player
    
    Camera.CameraType = Enum.CameraType.Custom
    
    local function atualizarCamera()
        if not SpectateTarget or not SpectateTarget.Character then
            pararSpectate()
            return
        end
        
        local hum = SpectateTarget.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            pararSpectate()
            return
        end
        
        Camera.CameraSubject = hum
    end
    
    atualizarCamera()
    
    if SpectateConnection then
        pcall(function() SpectateConnection:Disconnect() end)
    end
    
    SpectateConnection = SpectateTarget.CharacterAdded:Connect(function()
        task.wait(0.5)
        atualizarCamera()
    end)
    
    addConnection(SpectateConnection)
    atualizarStatusSpectate()
end

