    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Font = 2
    text.ZIndex = 6
    espNames[player] = {text = text}
end

local function updateESPName(player)
    local data = espNames[player]
    if not data then return end
    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not head or not hum or hum.Health <= 0 then data.text.Visible = false return end
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
    if not onScreen then data.text.Visible = false return end
    data.text.Text = player.Name
    data.text.Position = Vector2.new(pos.X, pos.Y)
    data.text.Visible = true
end

local function removeESPName(player)
    local data = espNames[player]
    if data then data.text:Remove(); espNames[player] = nil end
end

-- ============================================
-- ESP DISTANCE
-- ============================================
local function createESPDistance(player)
    if espDistances[player] then return end
    local text = Drawing.new("Text")
    text.Visible = false
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Size = 12
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Font = 2
    text.ZIndex = 6
    espDistances[player] = {text = text}
end

local function updateESPDistance(player)
    local data = espDistances[player]
    if not data then return end
    local char = player.Character
    local localChar = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not localRoot or not hum or hum.Health <= 0 then data.text.Visible = false return end
    local pos, onScreen = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, -3, 0))
    if not onScreen then data.text.Visible = false return end
    local distance = (root.Position - localRoot.Position).Magnitude
    data.text.Text = string.format("[%dm]", math.floor(distance + 0.5))
    data.text.Position = Vector2.new(pos.X, pos.Y)
    data.text.Visible = true
end

local function removeESPDistance(player)
    local data = espDistances[player]
    if data then data.text:Remove(); espDistances[player] = nil end
end

local function updateAllESP()
    if not keyValidada then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local hasBox = espBoxes[player] ~= nil
            local hasLine = espLines[player] ~= nil
            local hasName = espNames[player] ~= nil
            local hasDistance = espDistances[player] ~= nil

            if settings.ESPBox and not hasBox then createESPBox(player) end
            if settings.ESPLine and not hasLine then createESPLine(player) end
            if settings.ESPName and not hasName then createESPName(player) end
            if settings.ESPDistance and not hasDistance then createESPDistance(player) end

            if not settings.ESPBox and hasBox then removeESPBox(player) end
            if not settings.ESPLine and hasLine then removeESPLine(player) end
            if not settings.ESPName and hasName then removeESPName(player) end
            if not settings.ESPDistance and hasDistance then removeESPDistance(player) end

            if settings.ESPBox and espBoxes[player] then updateESPBox(player) end
            if settings.ESPLine and espLines[player] then updateESPLine(player) end
            if settings.ESPName and espNames[player] then updateESPName(player) end
            if settings.ESPDistance and espDistances[player] then updateESPDistance(player) end
        end
    end

    local playersToRemove = {}
    for player, _ in pairs(espBoxes) do
        if not player or not player.Parent then table.insert(playersToRemove, player) end
    end
    for _, player in pairs(playersToRemove) do removeESPBox(player) end

    playersToRemove = {}
    for player, _ in pairs(espLines) do
        if not player or not player.Parent then table.insert(playersToRemove, player) end
    end
    for _, player in pairs(playersToRemove) do removeESPLine(player) end

    playersToRemove = {}
    for player, _ in pairs(espNames) do
        if not player or not player.Parent then table.insert(playersToRemove, player) end
    end
    for _, player in pairs(playersToRemove) do removeESPName(player) end

    playersToRemove = {}
    for player, _ in pairs(espDistances) do
        if not player or not player.Parent then table.insert(playersToRemove, player) end
    end
    for _, player in pairs(playersToRemove) do removeESPDistance(player) end
end

-- ============================================
-- AIMBOT (CORRIGIDO)
-- ============================================

-- Verifica se o alvo ainda é válido
local function isTargetValid(target)
    if not target then return false end
    if target == LocalPlayer then return false end
    
    local character = target.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    local head = character:FindFirstChild("Head")
    if not head then return false end
    
    -- Verifica se o alvo está dentro do FOV
    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    
    local viewportSize = Camera.ViewportSize
    local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local distance = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
    
    if distance > settings.FOV then return false end
    
    -- Verifica Wall Check
    if settings.WallCheck then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {LocalPlayer.Character}
        local result = workspace:Raycast(
            Camera.CFrame.Position,
            (head.Position - Camera.CFrame.Position).Unit * 1000,
            params
        )
        if not result or not result.Instance:IsDescendantOf(character) then
            return false
        end
    end
    
    return true
end

-- Seleciona o melhor alvo baseado no centro da tela
local function selectBestTarget()
    local bestTarget = nil
    local bestDistance = math.huge
    local viewportSize = Camera.ViewportSize
    local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                        
                        if dist < settings.FOV and dist < bestDistance then
                            -- Verifica Wall Check
                            local validTarget = true
                            if settings.WallCheck then
                                local params = RaycastParams.new()
                                params.FilterType = Enum.RaycastFilterType.Blacklist
                                params.FilterDescendantsInstances = {LocalPlayer.Character}
                                local result = workspace:Raycast(
                                    Camera.CFrame.Position,
                                    (head.Position - Camera.CFrame.Position).Unit * 1000,
                                    params
                                )
                                if not result or not result.Instance:IsDescendantOf(player.Character) then
                                    validTarget = false
                                end
                            end
                            
                            if validTarget then
                                bestTarget = player
                                bestDistance = dist
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

local function aimbot()
    if not settings.Aimbot or not keyValidada then return end
    
    -- Verifica se o alvo atual ainda é válido
    if currentTarget and isTargetValid(currentTarget) then
        -- Mantém o alvo atual
    else
        -- Procura um novo alvo
        currentTarget = selectBestTarget()
        if not currentTarget then
            return
        end
    end
    
    -- Se chegou aqui, tem um alvo válido
    local head = currentTarget.Character:FindFirstChild("Head")
    if not head then
        currentTarget = nil
        return
    end
    
    -- Aplica o smooth para mirar no alvo
    local targetPos = head.Position
    local cameraPos = Camera.CFrame.Position
    local direction = (targetPos - cameraPos).unit
    
    -- Verifica se a direção é válida
    if direction.Magnitude < 0.001 then
        return
    end
    
    local targetCFrame = CFrame.lookAt(cameraPos, cameraPos + direction)
    local currentCFrame = Camera.CFrame
    local lerpedCFrame = currentCFrame:Lerp(targetCFrame, 0.4)
    
    Camera.CFrame = lerpedCFrame
end

