local function addDrawing(drawing)
    if drawing then
        table.insert(AllDrawings, drawing)
    end
    return drawing
end

local function cleanup()
    for _, conn in pairs(Connections) do
        if conn then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(Connections)

    for _, drawing in pairs(AllDrawings) do
        if drawing then
            pcall(function() drawing:Remove() end)
        end
    end
    table.clear(AllDrawings)

    for _, data in pairs(EspData) do
        if data then
            for _, obj in pairs(data) do
                if obj and typeof(obj) == "userdata" then
                    pcall(function() obj:Remove() end)
                end
            end
        end
    end
    table.clear(EspData)

    for _, guiName in ipairs({"KeyScreen", "SaadxXIT"}) do
        local gui = game.Players.LocalPlayer.PlayerGui:FindFirstChild(guiName)
        if gui then
            pcall(function() gui:Destroy() end)
        end
    end

    _G.SaadxCleanup = nil
end

